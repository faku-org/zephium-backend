[Unit]
Description=Zephium production backup, WAL and disk monitor
After=docker.service
Requires=docker.service
OnFailure=zephium-backup-alert@backup_monitor_failed.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=zephium-backups
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/zephium-backups/monitor.sh /etc/zephium-backups/config
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zephium-backups
StandardOutput=journal
StandardError=null
