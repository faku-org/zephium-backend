[Unit]
Description=Zephium production %i backup
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
OnFailure=zephium-backup-alert@backup_failed.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=zephium-backups
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/zephium-backups/backup.sh %i /etc/zephium-backups/config
TimeoutStartSec=3000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zephium-backups
StandardOutput=journal
StandardError=null
