# Include with the image's normal configuration; pg_hba remains SCRAM authenticated.
listen_addresses='*'
max_connections=60
shared_buffers='1GB'
wal_level=replica
archive_mode=on
archive_command='pgbackrest --stanza=zephium archive-push %p'
archive_timeout='60s'
logging_collector=off
log_statement='none'
log_min_error_statement='panic'
log_error_verbosity='terse'
log_parameter_max_length=0
log_parameter_max_length_on_error=0
log_connections=off
log_disconnections=off
